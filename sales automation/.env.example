# Values belong in LC-AUTOMATION GitHub Actions secrets, never Git source.
TCP_CLIENT_ID=
TCP_CLIENT_SECRET=
TCP_API_KEY=
# Optional GitHub variable; same TCP company as payroll.
TCP_COMPANY_ID=

# Google Workspace app password for ab@caazllc.com.
# Already named this way in the old salesautomation repo; copy its value yourself.
CAAZ_GMAIL_APP_PASS=

# OneDrive Microsoft OAuth app and delegated file permission.
MS_CLIENT_ID=
MS_REFRESH_TOKEN=
# Only for a confidential OAuth application; public desktop apps leave blank.
MS_CLIENT_SECRET=
MS_TENANT_ID=common

# GitHub Actions supplies its token. Do not add a personal token here.
# Scheduled execution is gated by repository variable SALES_AUTOMATION_ENABLED.

# Altametrics SALES ONLY: regional portal credentials.
COLORADO_USERNAME=
COLORADO_PASSWORD=
AZ_USERNAME=
AZ_PASSWORD=
TX_USERNAME=
TX_PASSWORD=

# Optional authorized sessions saved by connect_altametrics.py after interactive
# sign-in. Sensitive values: keep in GitHub Secrets only. Expiry needs reconnect.
CO_ALTAMETRICS_SESSION=
AZ_ALTAMETRICS_SESSION=
TX_ALTAMETRICS_SESSION=
