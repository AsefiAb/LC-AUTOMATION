# Copy to .env and fill in locally. Never commit the populated .env file.
TCP_API_BASE_URL=https://api.tcplusondemand.com
TCP_TOKEN_URL=https://auth.api.tcplusondemand.com/oauth2/token
TCP_CLIENT_ID=
TCP_CLIENT_SECRET=
# Separate API key supplied by TCP; not the client ID or client secret.
TCP_API_KEY=
# Read scope for the reporting integration.
TCP_SCOPE=tcp-openapi/tcpopenapi.read
# Optional company ID in the TCP namespace; TCP defaults to 1 if omitted.
TCP_COMPANY_ID=

TCP_STORE_NUMBER=3356-01
# Current pay period: fill in actual company dates (YYYY-MM-DD).
TCP_PAY_PERIOD_START=
TCP_PAY_PERIOD_END=
